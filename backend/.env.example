# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studymate_dev
DB_USER=studymate
DB_PASSWORD=replace-with-your-local-password

# Authentication — generate long random values for local use
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DRIVER=local
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=20

# AI provider — keep the real key only in backend/.env
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
